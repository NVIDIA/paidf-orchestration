{
  "input_path": "s3://<your-input-bucket>/<your-workflow>/input",
  "max_imgs": 1,
  "output_directory": "s3://<your-output-bucket>/<your-workflow>/output",
  "external_services": true,
  "service_lifecycle": {
    "vlm_service": {
      "enabled": false,
      "replicas": 1
    },
    "llm_service": {
      "enabled": false,
      "replicas": 1
    },
    "image_edit_service": {
      "enabled": false,
      "replicas": 1
    }
  },
  "cosmos": {
    "vlm_service_url": "https://<your-vlm-endpoint>/v1",
    "llm_service_url": "https://<your-llm-endpoint>/v1",
    "image_edit_service_url": "https://<your-image-edit-endpoint>/v1",
    "vlm_model": "Qwen/Qwen3-VL-30B-A3B-Instruct-FP8",
    "llm_model": "Qwen/Qwen2.5-14B-Instruct",
    "image_edit_model": "Qwen/Qwen-Image-Edit-2511",
    "num_augmentation": 1,
    "external_services": true,
    "variable_distribution": {
      "variables": {
        "top_outer_color": {
          "black": 1.0
        },
        "top_outer_type": {
          "hoodie": 1.0
        },
        "bottom_type": {
          "jeans": 1.0
        },
        "bottom_color": {
          "blue": 1.0
        },
        "shoe_type": {
          "sneakers": 1.0
        },
        "shoe_color": {
          "white": 1.0
        }
      }
    }
  },
  "auto_labeling": {
    "tracker": "bytetrack",
    "threshold": 0.3,
    "vlm_service_url": "https://<your-vlm-endpoint>/v1",
    "llm_service_url": "https://<your-llm-endpoint>/v1",
    "vlm_model": "Qwen/Qwen3-VL-30B-A3B-Instruct-FP8",
    "llm_model": "Qwen/Qwen2.5-14B-Instruct",
    "external_services": true
  }
}
